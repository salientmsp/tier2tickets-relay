# Copy to .dev.vars for `wrangler dev`. NEVER commit .dev.vars (it holds secrets).
# These map to the CLI-only secrets in production.

# X-API-Key sent to Gorelo. Needs scopes: ticket write, asset/contact/client read.
GORELO_API_KEY="your-gorelo-api-key"

# Gates POST /admin/sync (sent as X-Admin-Key, X-API-Key, or Authorization: Bearer).
ADMIN_KEY="another-long-random-secret"

# Optional: enable the Sentry error monitor during `wrangler dev`. It is OFF by default
# (the deployed Worker opts in via wrangler.toml [vars]); leaving this unset keeps local
# runs from emitting to the hardcoded Sentry DSN. Set to "true" only if you want to test
# Sentry reporting locally.
# SENTRY_ENABLED="true"

# Monitoring-alert ingress (POST /v1/alerts). Each source (customer) has its own secret
# bound to its own IPs: a request must present the source's secret (Authorization: Bearer
# <secret> or X-Alert-Key: <secret>) AND come from that source's allowlisted IP.
#
# The built-in `default` source uses this secret + ALERT_ALLOWED_IPS:
ALERT_SHARED_SECRET="a-long-random-alert-secret"
# Add customers via ALERT_SOURCES + per-key vars (read by name), e.g.:
# ALERT_SOURCES="default, acme"
# ALERT_SECRET_ACME="another-long-random-secret"   # in prod: wrangler secret put ALERT_SECRET_ACME
# ALERT_IPS_ACME="198.51.100.0/24"                 # set alongside in wrangler.toml [vars]

# Optional: notifly (Apprise-style) URL(s) alerted when a queued ticket is
# dead-lettered (dropped after MAX_PENDING_ATTEMPTS failed Gorelo creates). One or
# more, comma/space separated. Leave unset to only log the drop.
# e.g. ntfy://alerts  |  slack://a/b/c/%23chan  |  Teams Workflows: take the Power
# Automate webhook URL and swap https -> workflows:
#   workflows://<env>.environment.api.powerplatform.com/powerautomate/.../invoke?...&sig=...
# The notifly Playground (https://notifly.sh/docs/builder/playground/) does this
# https -> workflows:// conversion client-side (nothing leaves your browser).
# NOTIFLY_URLS="ntfy://my-hdb-alerts"

# Optional: per-product Halo mock OAuth credentials (issue #51). Each product
# authenticates with its OWN client_id, so credentials are resolved per matched
# product. When both the id AND secret are set for a product, the /token endpoint
# validates them and (under HALO_TOKEN_ENFORCE) its resource requests are token-
# enforced; otherwise that product stays lenient (any creds accepted — still IP-gated).
# Set the same values on that product's Halo integration side.
#
# tier2 uses the original un-suffixed pair:
HALO_CLIENT_ID="halo-mock-client-id"
HALO_CLIENT_SECRET="halo-mock-client-secret"
# Huntress uses its own (its distinct client_id). Uncomment to enable validation:
# HALO_CLIENT_ID_HUNTRESS="13b3832f9306b677fb72eea412da5df7"
# HALO_CLIENT_SECRET_HUNTRESS="huntress-mock-client-secret"

# Optional: egress Jira fan-out for co-managed clients. Set ENABLE_JIRA (a [vars]
# flag in wrangler.toml) to "true", and list each enrolled client's Jira destination
# here as a JSON array (this secret holds credentials). A client is sent to Jira only
# when its Gorelo clientId has an entry below. "resolvedTransition" is the workflow
# transition used to close the issue on a ticket resolution (optional).
#
# Use a dedicated Atlassian SERVICE ACCOUNT for the credential — never a real
# employee's personal login (support.atlassian.com/user-management/docs/understand-service-accounts/):
# created in Atlassian Administration -> Directory -> Service accounts, it has no
# password, isn't tied to anyone leaving, and doesn't count against user-license seats.
# Either auth mode below works with a service account; pick one per client entry.
#
# Mode 1 — API token (simplest): Atlassian Administration -> Directory -> Service
# accounts -> the account -> Create credentials -> API token (or, if you can't create
# service accounts yet, a token generated at id.atlassian.com/manage-profile/security/api-tokens
# while logged in AS the service account).
# JIRA_TARGETS='[{"clientId":15567,"baseUrl":"https://acme.atlassian.net","projectKey":"SEC","issueType":"Task","email":"svc@acme.com","apiToken":"your-jira-api-token","resolvedTransition":"Done"}]'
#
# Mode 2 — OAuth 2.0 (machine-to-machine, no password/token to rotate by hand):
# Atlassian Administration -> Directory -> Service accounts -> the account ->
# Create credentials -> OAuth 2.0 -> select Jira scopes (read:jira-work, write:jira-work
# cover create/comment/transition). Uses client_credentials against auth.atlassian.com,
# so JiraClient calls api.atlassian.com/ex/jira/{cloudId} instead of the site directly.
# JIRA_TARGETS='[{"clientId":15567,"baseUrl":"https://acme.atlassian.net","projectKey":"SEC","issueType":"Task","oauthClientId":"your-oauth-client-id","oauthClientSecret":"your-oauth-client-secret","resolvedTransition":"Done"}]'
