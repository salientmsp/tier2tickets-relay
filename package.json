{
  "name": "tier2tickets-relay",
  "version": "1.0.0",
  "description": "Cloudflare Worker that impersonates a HaloPSA instance so Tier2Tickets / Helpdesk Buttons can create tickets in Gorelo.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:lan": "wrangler dev --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "check:allowscripts": "node scripts/check-allowscripts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply tier2tickets-relay --local",
    "db:seed:local": "wrangler d1 execute tier2tickets-relay --local --file=scripts/seed-dev.sql",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed:local",
    "dev:setup": "npm run db:migrate:local && npm run db:seed:local"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.2",
    "@cloudflare/workers-types": "5.20260804.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.119.0"
  },
  "dependencies": {
    "@ambersecurityinc/notifly": "0.7.1",
    "@sentry/cloudflare": "10.69.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
